      "boundElements": null,
      "updated": 1781006722566,
      "link": null,
      "locked": false,
      "text": "while ( true )\n        {\n            line = f.nextLine();\n            if ( line.equals(\"%%\") )\n                break;\n            String[] parts = line.split(\":\");\n            r.exits[i] = parts[0];\n            r.destinations[i] = Integer.parseInt(parts[1]);\n            i++;\n        }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while ( true )\n        {\n            line = f.nextLine();\n            if ( line.equals(\"%%\") )\n                break;\n            String[] parts = line.split(\":\");\n            r.exits[i] = parts[0];\n            r.destinations[i] = Integer.parseInt(parts[1]);\n            i++;\n        }",
      "autoResize": true,
      "lineHeight": 1.25
